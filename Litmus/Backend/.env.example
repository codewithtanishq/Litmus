# Swarm Debugger — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Sandbox Limits ─────────────────────────────────────────────────────────────
# Wall-clock seconds a candidate execution may run before being killed.
SANDBOX_TIMEOUT_SECONDS=30
# RAM (MB) the candidate container may use.
SANDBOX_MEMORY_MB=256
# CPU fraction the candidate container may use (0.0–1.0).
SANDBOX_CPU_LIMIT=0.5
# Maximum number of processes inside the container.
SANDBOX_MAX_PROCESSES=32
# Maximum bytes of stdout+stderr that will be captured.
SANDBOX_MAX_OUTPUT_BYTES=65536
# Maximum bytes of source code accepted as input.
SANDBOX_MAX_SOURCE_BYTES=262144
# Maximum bytes of test suite accepted as input.
SANDBOX_MAX_TEST_BYTES=262144

# ── Docker ─────────────────────────────────────────────────────────────────────
# Docker image used to run candidates.
SANDBOX_DOCKER_IMAGE=python:3.12-slim

# ── Database ───────────────────────────────────────────────────────────────────
# Path to the SQLite database file.  Use :memory: for ephemeral (tests only).
DATABASE_PATH=swarm_debugger.db
